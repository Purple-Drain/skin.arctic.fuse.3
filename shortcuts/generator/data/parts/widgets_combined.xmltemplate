<!-- skin.arctic.fuse.3 #28 lever (c): when Widgets.StaticSubmenuTiles is on, a
     Custom_Submenu row's dynamic plugin://script.skinvariables get_shortcuts_node
     content is suppressed here (kept off the render tree entirely, not just
     hidden, so it never dispatches a CDirectoryProvider job) in favour of the
     static equivalent from home_widgets_combined_staticsubmenu.xml at the same
     container id. Every other row is unaffected: widget_is_custom_submenu is
     False for them, so the condition is always true. -->
<include content="Hub_Combined_Widget" condition="!{widget_is_custom_submenu} | !Skin.HasSetting(Widgets.StaticSubmenuTiles)">
    <param name="id">{widget_id}</param>
    <param name="content">{widget_path}</param>
    <param name="include">{widget_include}</param>
    <param name="target">{widget_target}</param>
    <param name="sortby">{widget_sortby}</param>
    <param name="sortorder">{widget_sortorder}</param>
    <param name="limit">{widget_limit}</param>
    <param name="autoscroll">{widget_isautoscroll}</param>
    <param name="visible">String.IsEqual(Container(601).ListItem.Property(guid),{widget_guid})</param>
</include>
